// Schéma de base de données — Plateforme SaaS de vente de formations
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// UTILISATEURS & RÔLES
// ============================================================

enum Role {
  ADMIN
  TRAINER
  STUDENT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  trainer Trainer?
  student Student?

  @@map("users")
}

// ============================================================
// FORMATEUR
// ============================================================

model Trainer {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicName  String   @map("public_name")
  bio         String?
  avatarUrl   String?  @map("avatar_url")
  slug        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")

  courses      Course[]
  subscription Subscription?

  @@map("trainers")
}

// ============================================================
// CLIENT
// ============================================================

model Student {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  orders      Order[]
  enrollments Enrollment[]

  @@map("students")
}

// ============================================================
// FORMATION
// ============================================================

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Course {
  id          String       @id @default(uuid())
  trainerId   String       @map("trainer_id")
  trainer     Trainer      @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  title       String
  slug        String       @unique
  description String
  coverImage  String?      @map("cover_image")
  price       Int          // en unité monétaire la plus petite (ex: FCFA, pas de décimales)
  currency    String       @default("XOF")
  category    String?
  status      CourseStatus @default(DRAFT)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  modules     Module[]
  orders      Order[]
  enrollments Enrollment[]

  @@map("courses")
}

model Module {
  id       String @id @default(uuid())
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int    @default(0)

  lessons Lesson[]

  @@map("modules")
}

enum LessonType {
  VIDEO
  DOCUMENT
}

model Lesson {
  id       String     @id @default(uuid())
  moduleId String     @map("module_id")
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String
  type     LessonType
  order    Int        @default(0)

  video    Video?
  document Document?

  progress LessonProgress[]

  @@map("lessons")
}

model Video {
  id           String  @id @default(uuid())
  lessonId     String  @unique @map("lesson_id")
  lesson       Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  storageKey   String  @map("storage_key") // clé privée dans le bucket (jamais l'URL publique)
  durationSec  Int?    @map("duration_sec")

  @@map("videos")
}

model Document {
  id         String @id @default(uuid())
  lessonId   String @unique @map("lesson_id")
  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  storageKey String @map("storage_key")
  fileName   String @map("file_name")

  @@map("documents")
}

// ============================================================
// COMMANDES & PAIEMENTS
// ============================================================

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id        String      @id @default(uuid())
  studentId String      @map("student_id")
  student   Student     @relation(fields: [studentId], references: [id])
  courseId  String      @map("course_id")
  course    Course      @relation(fields: [courseId], references: [id])
  amount    Int
  currency  String      @default("XOF")
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  payment    Payment?
  enrollment Enrollment?

  @@map("orders")
}

enum PaymentMethod {
  ORANGE_MONEY
  WAVE
  MTN_MOMO
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique @map("order_id")
  order           Order         @relation(fields: [orderId], references: [id])
  method          PaymentMethod
  providerRef     String?       @map("provider_ref") // référence transaction chez le provider
  status          PaymentStatus @default(PENDING)
  rawWebhookData  Json?         @map("raw_webhook_data")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

// ============================================================
// ACCÈS & PROGRESSION
// ============================================================

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  student    Student  @relation(fields: [studentId], references: [id])
  courseId   String   @map("course_id")
  course     Course   @relation(fields: [courseId], references: [id])
  orderId    String   @unique @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id])
  grantedAt  DateTime @default(now()) @map("granted_at")

  lessonProgress LessonProgress[]

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id           String     @id @default(uuid())
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String     @map("lesson_id")
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed    Boolean    @default(false)
  completedAt  DateTime?  @map("completed_at")

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}

// ============================================================
// ABONNEMENTS (SaaS — plan du formateur)
// ============================================================

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

model Subscription {
  id        String             @id @default(uuid())
  trainerId String             @unique @map("trainer_id")
  trainer   Trainer            @relation(fields: [trainerId], references: [id])
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now()) @map("started_at")
  endsAt    DateTime?          @map("ends_at")

  @@map("subscriptions")
}
